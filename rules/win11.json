          { "path": "collectors.win11.data.tpm.present", "operator": "isTrue" },
          { "path": "collectors.win11.data.tpm.majorVersion", "operator": "greaterThan", "value": 1.9 },
          { "path": "collectors.win11.data.tpm.enabled", "operator": "isFalse" }
