      "type": "object",
      "required": ["ruleId", "severity", "state", "title"],
      "additionalProperties": false,
      "properties": {
        "ruleId": { "type": "string" },
        "ruleVersion": { "type": ["integer", "null"] },
        "severity": { "enum": ["Critical", "High", "Medium", "Low", "Info"] },
        "state": {
          "description": "Indeterminate NÃO pontua no score e aparece no bloco 'não foi possível verificar', com o motivo.",
          "enum": ["Compliant", "NonCompliant", "Indeterminate"]
        },
        "indeterminateReason": { "type": ["string", "null"] },
        "weight": { "type": ["integer", "null"], "minimum": 0 },
        "title": { "type": "string" },
        "clientText": { "type": ["string", "null"] },
        "recommendedAction": { "type": ["string", "null"] },
        "evidence": { "type": ["object", "null"] },
        "linkedOptimizations": { "type": ["array", "null"], "items": { "type": "string" } },
        "markedFalsePositive": { "type": "boolean" },
        "falsePositiveJustification": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "description": "Falso positivo marcado exige justificativa — é o que alimenta a revisão da matriz (doc 03 §6).",
          "if": { "properties": { "markedFalsePositive": { "const": true } }, "required": ["markedFalsePositive"] },
          "then": { "properties": { "falsePositiveJustification": { "type": "string", "minLength": 1 } }, "required": ["falsePositiveJustification"] }
        },
        {
          "if": { "properties": { "state": { "const": "Indeterminate" } }, "required": ["state"] },
          "then": { "properties": { "indeterminateReason": { "type": "string", "minLength": 1 } }, "required": ["indeterminateReason"] }
        }
      ]
    },

