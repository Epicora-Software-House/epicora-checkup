<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <assemblyIdentity version="1.0.0.0" name="EpicoraCheckup.app" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          highestAvailable, NÃO requireAdministrator — ver ADR-011.

          Com requireAdministrator, o técnico sem a senha de administrador local não
          consegue nem abrir a ferramenta, o que torna o critério de aceite 5 do doc 01
          impossível de cumprir. Com highestAvailable, quem é administrador eleva e
          coleta TPM, BitLocker e SMART; quem não é roda sem elevação e essas três
          resolvem Indeterminate, com motivo, no relatório.
        -->
        <requestedExecutionLevel level="highestAvailable" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!--
    DPI declarado AQUI, e não em App.config — ADR-013.

    A documentação da Microsoft desaconselha o manifest para .NET Framework 4.7+ com um
    motivo específico: ele "overrides settings defined on the app.config file". A ressalva
    pressupõe que exista um App.config, e a partir do executável único não existe — o
    arquivo de configuração seria um segundo arquivo ao lado, que é justamente o que o
    ADR-013 elimina. Sem App.config, o manifest não sobrescreve nada: é a única fonte.

    Sem isto a janela sai borrada em tela com escala de 125% ou 150%, que é a configuração
    de fábrica de boa parte dos notebooks que a Epicora vai visitar.

    PerMonitorV2 é o modo recomendado para aplicação WinForms nova; o dpiAware antigo fica
    junto porque Windows anterior ao 1703 ignora o elemento novo e leria só ele.
    https://learn.microsoft.com/en-us/dotnet/desktop/winforms/high-dpi-support-in-windows-forms
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 e 11. Sem isto, APIs de compatibilidade reportam versão antiga. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

</assembly>
