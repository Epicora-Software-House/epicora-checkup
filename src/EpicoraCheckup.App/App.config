<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!--
    DPI. Vai AQUI e não no app.manifest: para .NET Framework 4.7+ a documentação da
    Microsoft diz que o caminho pelo manifest não é mais recomendado, porque sobrescreve
    o que estiver no app.config.

    PerMonitorV2 habilita todos os recursos de alta DPI suportados a partir do 4.7, e a
    própria doc diz que essa única opção "is generally adequate for new Windows Forms
    applications". Sem isto, a janela sai borrada em notebook com escala 125% ou 150% —
    que é a configuração de fábrica de boa parte das máquinas que a Epicora vai visitar.

    https://learn.microsoft.com/en-us/dotnet/desktop/winforms/high-dpi-support-in-windows-forms
  -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>

</configuration>
